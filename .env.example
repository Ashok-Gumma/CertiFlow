# Application Port
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/certiflow_db?schema=public

# Redis Configuration (BullMQ)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=certiflow_super_secret_production_jwt_key_2026
JWT_EXPIRES_IN=24h

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# WhatsApp Simulation Settings
WHATSAPP_FAILURE_RATE=0.1
WHATSAPP_TIMEOUT_RATE=0.05
MAX_DELIVERY_RETRIES=3

# Overdue Batch Threshold (Hours)
OVERDUE_BATCH_HOURS=24
